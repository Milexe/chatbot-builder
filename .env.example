# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: public demo bot for landing (loads widget.js from this origin).
# Leave NEXT_PUBLIC_DEMO_WIDGET_ORIGIN unset to use the current host.
# On localhost the landing always loads local widget.js anyway.
# NEXT_PUBLIC_DEMO_BOT_ID=
# NEXT_PUBLIC_DEMO_WIDGET_ORIGIN=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (sb_publishable_... or legacy anon JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by newer Supabase docs:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_... or legacy service_role) — server only
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (chat + embeddings — one key)
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
